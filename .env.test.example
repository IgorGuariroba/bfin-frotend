# Arquivo de exemplo das variáveis de ambiente para testes E2E
# Copie este arquivo para .env.test.local e ajuste os valores

# Credenciais para testes (usuário de teste válido no backend)
TEST_USER_EMAIL=teste@bfin.com.br
TEST_USER_PASSWORD=senha123

# URL base para os testes (automaticamente configurado pelo Playwright)
PLAYWRIGHT_BASE_URL=http://localhost:5173

# URL da API (proxy configurado no Vite para localhost:3000)
VITE_API_BASE_URL=http://localhost:3000

# Configurações do ambiente de teste
NODE_ENV=test
CI=false