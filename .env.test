# Arquivo de exemplo para variáveis de ambiente dos testes E2E
# Copie para .env.test.local e ajuste conforme necessário

# URL base da aplicação para testes
PLAYWRIGHT_BASE_URL=http://localhost:5173

# Configurações do banco de dados para testes (se aplicável)
DATABASE_URL_TEST=postgresql://localhost:5432/bfin_test

# Configurações de API para testes
API_BASE_URL=http://localhost:3001/api
API_TIMEOUT=10000

# Configurações de usuário para testes
TEST_USER_EMAIL=usertest@gmail.com
TEST_USER_PASSWORD=123456
TEST_USER_NAME=usertest

# Configurações do Playwright
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADED=false
PLAYWRIGHT_SLOW_MO=0
PLAYWRIGHT_TIMEOUT=30000

# Configurações de depuração
DEBUG_MODE=false
TAKE_SCREENSHOTS=on-failure
RECORD_VIDEOS=on-failure

# Configurações de mock/stub
MOCK_API_RESPONSES=false
USE_REAL_DATABASE=false