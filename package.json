{
  "name": "bfin-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "setup:npmrc": "node scripts/setup-npmrc.js",
    "install:all": "node scripts/setup-npmrc.js && npm install",
    "update:sdk": "node scripts/update-sdk.js",
    "dev": "vite",
    "build": "vite build",
    "build:check": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "theme:typegen": "npx @chakra-ui/cli typegen src/theme/theme.ts",
    "preview": "vite preview",
    "check:tokens": "bash scripts/check-design-tokens.sh",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.34.0",
    "@hookform/resolvers": "^3.3.4",
    "@igorguariroba/bfin-sdk": "^0.12.0",
    "@internationalized/date": "^3.12.0",
    "@tanstack/react-query": "^5.17.9",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.309.0",
    "next-themes": "^0.4.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.3",
    "react-icons": "^5.6.0",
    "react-router-dom": "^6.30.3",
    "recharts": "^3.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.34.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-react": "^4.2.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --no-warn-ignored --report-unused-disable-directives --max-warnings 0",
      "bash -c 'npx tsc --noEmit'"
    ]
  }
}
